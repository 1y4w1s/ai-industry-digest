# Supabase 配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# DeepSeek API（后续阶段使用）
DEEPSEEK_API_KEY=your-deepseek-api-key

# AI model config (optional; defaults to DeepSeek)
AI_API_BASE_URL=https://api.deepseek.com/v1/chat/completions
AI_MODEL=deepseek-chat

# Public page base URL (required for production SEO)
PUBLIC_BASE_URL=http://localhost:8000

# 管理员用户名（Vite 前端构建注入）
VITE_ADMIN_USER=your-admin-username

# Redis (optional; defaults to redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# 飞书 Webhook（可选）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# Logging (optional; defaults to INFO / text format)
LOG_LEVEL=INFO
LOG_FORMAT=text

# GitHub token (optional; raises GitHub API rate limit)
GITHUB_TOKEN=

# Newsletter SMTP (for sending email digests)
NEWSLETTER_BASE_URL=http://localhost:8000
NEWSLETTER_FROM=Signal <news@example.com>
NEWSLETTER_ESP=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# Newsletter: Resend API (alternative to SMTP)
RESEND_API_KEY=

# Frontend Vite vars (also set in frontend/.env)
VITE_API_URL=/api
VITE_SUPABASE_ANON_KEY=your-anon-key

# Social collector tokens (optional; feature not implemented)
# TWITTER_BEARER_TOKEN=
# YOUTUBE_API_KEY=
# BILIBILI_COOKIE=
